import java.util.Scanner;
public class DolaresAPesosMexicanos {
    public static void main(String[] args) {
        Scanner entrada = new Scanner(System.in);

        System.out.print("Ingrese la cantidad en dolares: ");
        double dolares = entrada.nextDouble();

        while (dolares < 0) {
            System.out.println("La cantidad no puede ser negativa");
            System.out.print("Ingrese la cantidad en dolares: ");
            dolares = entrada.nextDouble();
        }

        System.out.print("Ingrese el tipo de cambio (pesos por dolar): ");
        double tipo_cambio = entrada.nextDouble();

        while (tipo_cambio <= 0) {
            System.out.println("El tipo de cambio debe ser mayor que 0");
            System.out.print("Ingrese el tipo de cambio (pesos por dolar): ");
            tipo_cambio = entrada.nextDouble();
        }

        double pesos = dolares * tipo_cambio;

        System.out.println(
            "La cantidad equivalente en pesos mexicanos es: " + pesos
        );

        entrada.close();
    }
}
